# JFK Travel ERP environment template
# This template defaults to the temporary 1GB direct-deployment profile.
# Replace every value marked "change-me" or "example.com" before production.

# Application
APP_NAME=JFK Travel ERP API
ENVIRONMENT=production
API_PREFIX=/api/v1
ALLOWED_ORIGINS=https://erp.example.com
COOKIE_SECURE=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_UPLOAD_BYTES=5242880

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-a-valid-fernet-key

# PostgreSQL
# POSTGRES_* values are used by Docker/provisioning; DATABASE_URL is used by FastAPI.
POSTGRES_DB=jfk_erp
POSTGRES_USER=jfk
POSTGRES_PASSWORD=change-me-strong-database-password
DATABASE_URL=postgresql+psycopg://jfk:change-me-strong-database-password@127.0.0.1:5432/jfk_erp
# Docker alternative:
# DATABASE_URL=postgresql+psycopg://jfk:change-me-strong-database-password@db:5432/jfk_erp

# Initial users
# ADMIN is always seeded when missing. MANAGER is automatically seeded only in development.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_NAME=JFK Administrator
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=change-me-strong-manager-password

# Optional Redis/Celery background processing
# Keep both false for the 1GB direct-deployment profile.
REDIS_ENABLED=false
CELERY_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
# Docker alternative: REDIS_URL=redis://redis:6379/0

# Files and malware scanning
# Uploads stay disabled until local storage support and malware scanning are enabled.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/var/lib/jfk-erp/uploads
FILE_UPLOADS_ENABLED=false
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
# Docker alternative: CLAMAV_HOST=clamav

# S3-compatible storage; ignored when uploads are disabled or STORAGE_BACKEND is not "s3".
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key
S3_BUCKET=jfk-documents
# Docker alternatives: S3_ENDPOINT=http://minio:9000 and S3_PUBLIC_ENDPOINT=http://localhost:9000

# SMTP; leave SMTP_HOST empty to disable outbound email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Frontend build and optional Docker/smoke-test settings
VITE_API_URL=/api/v1
HTTP_PORT=8080
SMOKE_BASE_URL=http://127.0.0.1:8080/api/v1
